{
  "name": "tradingray-widget",
  "version": "1.0.0",
  "description": "Ultra-lightweight, zero-dependency real-time crypto chart widget (Candlesticks & Price Line) with direct exchange WebSocket multiplexing.",
  "license": "MIT",
  "homepage": "https://tradingray.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/tradingray/tradingray-widget.git"
  },
  "bugs": {
    "url": "https://github.com/tradingray/tradingray-widget/issues"
  },
  "keywords": [
    "crypto",
    "chart",
    "candlestick",
    "sparkline",
    "price-chart",
    "trading",
    "websocket",
    "binance",
    "bybit",
    "okx",
    "coinbase",
    "kraken",
    "hyperliquid",
    "web-component",
    "widget",
    "tradingray"
  ],
  "type": "module",
  "main": "./dist/tradingray-widget.js",
  "module": "./dist/tradingray-widget.esm.js",
  "unpkg": "./dist/tradingray-widget.min.js",
  "jsdelivr": "./dist/tradingray-widget.min.js",
  "types": "./dist/tradingray-widget.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tradingray-widget.d.ts",
      "import": "./dist/tradingray-widget.esm.js",
      "default": "./dist/tradingray-widget.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "test": "node --test ./test/widget.test.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
